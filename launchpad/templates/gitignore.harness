# launchpad harness — skill symlinks (apply-harness)
# Re-run: launchpad apply-harness --apply
# Use /* not /*/ — git treats skill mirrors as symlinks, not directories.
.harness/skills/
.agents/skills/*
!.agents/skills/prayog-skills/
!prayog-skills/
.claude/skills/*
.cursor/skills/

# launchpad harness — deployed shared references (copy of prayog-skills/references/)
# Managed by apply-harness; reset-harness removes it.
references/
