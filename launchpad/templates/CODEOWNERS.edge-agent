# Edge agent profile — copy to .github/CODEOWNERS in each edge-agent repo
# Replace @example-org/... with actual GitHub org/team names.
#
# Branch protection required:
#   Settings → Branches → develop → "Require review from Code Owners" ON
#
# Sign-off workflow: launchpad/playbook/ship/delivery-workflow.md § Sign-off workflow

# ── Spec pipeline reports (skill gates) ──────────────────────────────────────

/docs/specification/reports/Technical-Review-*       @example-org/pe-team
/docs/specification/reports/Implementation-Plan-*    @example-org/edge-agent-devs
/docs/specification/reports/Ground-Report-*          @example-org/edge-agent-devs
/docs/specification/reports/Feasibility-Report-*     @example-org/pm-team @example-org/edge-agent-devs

# ── Product specs ─────────────────────────────────────────────────────────────

/docs/specification/product/                         @example-org/pm-team @example-org/edge-agent-devs
/docs/specification/adr/                             @example-org/pe-team
/docs/specification/as-built/                        @example-org/edge-agent-devs

# ── Constitution and skills ───────────────────────────────────────────────────

.cursor/rules/                                       @example-org/pe-team
.agents/skills/                                      @example-org/edge-agent-devs

# ── Source, tests, docker ─────────────────────────────────────────────────────

/src/                                                @example-org/edge-agent-devs
/tests/                                              @example-org/edge-agent-devs
/docker/                                             @example-org/edge-agent-devs

# ── Default ───────────────────────────────────────────────────────────────────

*                                                    @example-org/edge-agent-devs
